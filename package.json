{
  "name": "react-vite-tailwind",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run test && npm run build",
    "preview": "vite preview",
    "generate:nifty750": "node scripts/build_nifty_750_official.mjs",
    "generate:nifty750:synthetic-demo": "node scripts/generate_nifty_750_10y.mjs",
    "generate:itc:synthetic": "node scripts/build_itc_data.mjs",
    "data:refresh": "python3 scripts/data_collector/fetch_itc_data.py all"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "lucide-react": "^1.8.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "recharts": "^3.8.1",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "22.19.17",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "vitest": "^3.2.4",
    "vite": "7.2.4",
    "vite-plugin-singlefile": "2.3.0"
  }
}
